# Console sign-in. Copy to .env.local. SENTRY_SECRET signs the session cookie: 32 random bytes as hex,
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Team accounts live in users.local.json; add them with: node scripts/add-user.mjs <username> "<Name>" <admin|operator|viewer>
SENTRY_SECRET=

# Owners' People page (/people): each backend's owner API. Server only; never sent to the browser.
# The key is the same value as OWNER_API_KEY on that backend (32+ characters). Leave a pair empty
# and the page shows that system as "not connected" and still works for the other.
SAMVADIA_API_URL=
SAMVADIA_OWNER_KEY=
SOCIA_API_URL=
SOCIA_OWNER_KEY=
